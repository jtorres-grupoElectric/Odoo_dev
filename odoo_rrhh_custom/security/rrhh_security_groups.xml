<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_rrhh_custom" model="ir.module.category">
        <field name="name">RRHH Custom</field>
        <field name="description">Roles del módulo custom de Recursos Humanos</field>
        <field name="sequence">20</field>
    </record>

    <!-- Empleado: solicitar permisos; ver estado de sus propias solicitudes -->
    <record id="group_rrhh_empleado" model="res.groups">
        <field name="name">Empleado</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
    </record>

    <!-- Jefe de Departamento: crear solicitud de contratación; aprobar candidatos;
         aprobar/rechazar permisos de sus empleados.
         Nota: NO hereda Empleado a propósito. La regla de registro de
         labor.permission que limita "solo ver las propias" está condicionada
         a group_rrhh_empleado, y si este grupo la heredara quedaría igual de
         restringido que un Empleado normal, perdiendo visibilidad de los
         permisos de su equipo. Los accesos que sí necesita se otorgan de
         forma independiente en ir.model.access.csv. -->
    <record id="group_rrhh_jefe_departamento" model="res.groups">
        <field name="name">Jefe de Departamento</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
    </record>

    <!-- Especialista RRHH: gestión completa (candidatos, agencias, empleados,
         salario individual, documentos); visibilidad total del flujo.
         Tampoco hereda Empleado, por la misma razón que Jefe de Departamento.
         Implica "Oficial de RRHH" (hr.group_hr_user): el flujo de contratación
         y de planilla lee la ficha completa del empleado (fecha de ingreso,
         RTN, banco, feriados trabajados, horas extra…), campos que un usuario
         sin rol de RRHH no puede leer del perfil "público" de hr.employee. -->
    <record id="group_rrhh_especialista" model="res.groups">
        <field name="name">Especialista RRHH</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <!-- Dueño / Socio: aprobar solicitudes de contratación -->
    <record id="group_rrhh_socio" model="res.groups">
        <field name="name">Dueño / Socio</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
    </record>

    <!-- Solo Planillas: ve y trabaja únicamente el apartado "Planillas"
         (payroll.payslip / payroll.line). No ve Contratación, Salarios,
         Horas Extra, Feriados ni Permisos. Tiene los accesos de lectura
         mínimos que necesitan los cálculos de la planilla (salario
         individual, horas extra y feriados trabajados del empleado). -->
    <record id="group_rrhh_planillas" model="res.groups">
        <field name="name">Planillas</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
        <!-- Igual que Especialista: el cálculo de la planilla lee datos de la
             ficha del empleado que no están en su perfil público. Con esto el
             usuario también ve la app estándar "Empleados"; lo específico del
             módulo custom sigue limitado a "Planillas" por los menús. -->
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <!-- ================================================================
         Roles por apartado. Son grupos INDEPENDIENTES (sin jerarquía entre
         sí), así que en el formulario del usuario aparecen como casillas
         que se marcan/desmarcan por separado. Cada uno habilita SOLO el
         menú de su apartado y las ACL de sus modelos. Los botones de flujo
         sensibles (aprobar, finalizar, anular) siguen reservados a
         Especialista / Jefe / Socio según ya estaba.
         Todos implican "Oficial de RRHH" (hr.group_hr_user) porque cualquier
         apartado de RRHH termina leyendo la ficha del empleado.
         ================================================================ -->

    <record id="group_rrhh_contratacion" model="res.groups">
        <field name="name">Contratación</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_rrhh_salarios" model="res.groups">
        <field name="name">Salarios</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_rrhh_horas_extra" model="res.groups">
        <field name="name">Horas Extra</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_rrhh_feriados" model="res.groups">
        <field name="name">Feriados</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_rrhh_permisos" model="res.groups">
        <field name="name">Permisos Laborales</field>
        <field name="category_id" ref="module_category_rrhh_custom"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <!-- El administrador del sistema (grupo "Ajustes") recibe automáticamente
         "Especialista RRHH", que ya tiene acceso completo a todos los modelos
         del módulo y aparece en todos los menús. Así el admin ve y gestiona
         todo el RRHH sin tener que agregarlo a mano a cada grupo, y sin tocar
         la visibilidad del resto de los usuarios. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_rrhh_especialista'))]"/>
    </record>

</odoo>

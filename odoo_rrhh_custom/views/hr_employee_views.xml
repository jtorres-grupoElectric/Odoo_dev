<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_rrhh_custom" model="ir.ui.view">
        <field name="name">hr.employee.form.rrhh.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_rrhh_salaries" type="object"
                        class="oe_stat_button" icon="fa-money"
                        groups="odoo_rrhh_custom.group_rrhh_especialista,odoo_rrhh_custom.group_rrhh_socio">
                    <field name="rrhh_current_salary_id" widget="statinfo" string="Salario"/>
                </button>
                <button name="action_view_rrhh_vacations" type="object"
                        class="oe_stat_button" icon="fa-plane"
                        groups="odoo_rrhh_custom.group_rrhh_especialista,odoo_rrhh_custom.group_rrhh_socio,odoo_rrhh_custom.group_rrhh_empleado">
                    <field name="rrhh_vacation_available_days" widget="statinfo" string="Días disp."/>
                </button>
                <button name="action_view_rrhh_overtime" type="object"
                        class="oe_stat_button" icon="fa-clock-o"
                        groups="odoo_rrhh_custom.group_rrhh_especialista,odoo_rrhh_custom.group_rrhh_socio">
                    <field name="rrhh_overtime_count" widget="statinfo" string="Horas Extra"/>
                </button>
            </div>
            <page name="skills_resume" position="replace">
                <page name="rrhh_documentos" string="Documentos">
                    <field name="rrhh_document_request_id" invisible="1"/>
                    <group>
                        <field name="rrhh_document_state" readonly="1" widget="badge"
                               decoration-info="rrhh_document_state in ('pending', 'none')"
                               decoration-warning="rrhh_document_state == 'partial'"
                               decoration-success="rrhh_document_state in ('complete', 'verified')"/>
                    </group>
                    <field name="rrhh_document_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="document_type"/>
                            <field name="attachment_filename" invisible="1"/>
                            <field name="attachment" filename="attachment_filename" string="Archivo"/>
                            <field name="received"/>
                            <field name="received_date" readonly="not received"/>
                            <field name="verified" readonly="not received"/>
                            <field name="verified_date" readonly="not verified"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </page>
            <notebook position="inside">
                <page string="Compensación y Beneficios" name="rrhh_custom"
                      groups="odoo_rrhh_custom.group_rrhh_especialista,odoo_rrhh_custom.group_rrhh_socio">
                    <group string="Salario actual">
                        <field name="rrhh_current_salary_id" readonly="1"/>
                        <field name="rrhh_hire_date"/>
                    </group>
                    <group string="Historial salarial">
                        <field name="rrhh_salary_ids" nolabel="1" readonly="1">
                            <list class="o_rrhh_salary_list">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="base_salary"/>
                                <field name="base_salary_lps"/>
                                <field name="bonus"/>
                                <field name="net_salary_lps"/>
                                <field name="net_salary_usd"/>
                                <field name="effective_date"/>
                            </list>
                        </field>
                    </group>
                    <group string="Asignaciones de vacaciones">
                        <field name="rrhh_vacation_allocation_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="year"/>
                                <field name="allocated_days"/>
                                <field name="used_days"/>
                                <field name="available_days"/>
                            </list>
                        </field>
                    </group>
                    <group string="Horas extra">
                        <field name="rrhh_overtime_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="date"/>
                                <field name="hours"/>
                                <field name="amount" widget="monetary"/>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'requested'"
                                       decoration-warning="state == 'approved_jefe'"
                                       decoration-success="state == 'approved'"
                                       decoration-danger="state == 'rejected'"/>
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_labor_permission_list" model="ir.ui.view">
        <field name="name">labor.permission.list</field>
        <field name="model">labor.permission</field>
        <field name="arch" type="xml">
            <list string="Permisos Laborales" decoration-muted="state == 'rejected'">
                <field name="employee_id"/>
                <field name="permission_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'requested'"
                       decoration-warning="state == 'approved_jefe'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_labor_permission_form" model="ir.ui.view">
        <field name="name">labor.permission.form</field>
        <field name="model">labor.permission</field>
        <field name="arch" type="xml">
            <form string="Permiso Laboral">
                <header>
                    <button name="action_approve" string="Aprobar (Jefe)" type="object"
                            class="oe_highlight" invisible="state != 'requested'"
                            groups="odoo_rrhh_custom.group_rrhh_jefe_departamento"/>
                    <button name="action_reject" string="Rechazar" type="object"
                            invisible="state != 'requested'"
                            groups="odoo_rrhh_custom.group_rrhh_jefe_departamento"/>
                    <button name="action_approve_rrhh" string="Aprobar (RRHH)" type="object"
                            class="oe_highlight" invisible="state != 'approved_jefe'"
                            groups="odoo_rrhh_custom.group_rrhh_especialista"/>
                    <button name="action_reject" string="Rechazar" type="object"
                            invisible="state != 'approved_jefe'"
                            groups="odoo_rrhh_custom.group_rrhh_especialista"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,approved_jefe,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1" options="{'no_open': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'requested'"/>
                            <field name="permission_type" readonly="state != 'requested'"/>
                            <field name="vacation_balance_days" readonly="1"
                                   invisible="permission_type != 'vacacion'"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="state != 'requested'"/>
                            <field name="end_date" readonly="state != 'requested'"/>
                            <field name="days_count" readonly="1"/>
                            <field name="projected_vacation_balance" readonly="1"
                                   invisible="permission_type != 'vacacion' or not start_date or not end_date"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="rrhh_approver_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Justificación">
                        <field name="justification" nolabel="1" readonly="state != 'requested'"
                               required="permission_type == 'incapacidad'"/>
                        <field name="attachment_filename" invisible="1"/>
                        <field name="attachment" filename="attachment_filename" readonly="state != 'requested'"
                               required="permission_type == 'incapacidad'"
                               class="o_rrhh_attachment_narrow o_rrhh_attachment_row"/>
                        <widget name="doc_preview_button_compact"/>
                        <div class="text-muted" invisible="permission_type != 'incapacidad'">
                            Obligatorio para Ausencia por Incapacidad: adjunta la constancia del IHSS
                            u orden médica y describe brevemente el motivo.
                        </div>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_labor_permission_search" model="ir.ui.view">
        <field name="name">labor.permission.search</field>
        <field name="model">labor.permission</field>
        <field name="arch" type="xml">
            <search string="Buscar permisos laborales">
                <field name="employee_id"/>
                <field name="permission_type"/>
                <filter string="Mis permisos" name="my_permissions"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="Pendientes" name="pending"
                        domain="[('state', 'in', ('requested', 'approved_jefe'))]"/>
                <separator/>
                <filter string="Vacaciones" name="type_vacacion" domain="[('permission_type', '=', 'vacacion')]"/>
                <filter string="Incapacidad" name="type_incapacidad" domain="[('permission_type', '=', 'incapacidad')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Tipo de permiso" name="group_type" context="{'group_by': 'permission_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_labor_permission" model="ir.actions.act_window">
        <field name="name">Permisos Laborales</field>
        <field name="res_model">labor.permission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_labor_permission_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera solicitud de permiso</p>
        </field>
    </record>

    <menuitem id="menu_labor_permission" name="Permisos Laborales"
              parent="menu_rrhh_custom_root" action="action_labor_permission" sequence="50"
              groups="odoo_rrhh_custom.group_rrhh_empleado,odoo_rrhh_custom.group_rrhh_jefe_departamento,odoo_rrhh_custom.group_rrhh_especialista"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_document_request_list" model="ir.ui.view">
        <field name="name">employee.document.request.list</field>
        <field name="model">employee.document.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Documentos">
                <field name="employee_id"/>
                <field name="request_date"/>
                <field name="expected_delivery_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'partial'"
                       decoration-success="state in ('complete', 'verified')"/>
            </list>
        </field>
    </record>

    <record id="view_employee_document_request_search" model="ir.ui.view">
        <field name="name">employee.document.request.search</field>
        <field name="model">employee.document.request</field>
        <field name="arch" type="xml">
            <search string="Buscar solicitudes de documentos">
                <field name="employee_id"/>
                <filter string="Pendientes" name="pending" domain="[('state', 'in', ('pending', 'partial'))]"/>
                <filter string="Completas" name="complete" domain="[('state', 'in', ('complete', 'verified'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_employee_document_request_form" model="ir.ui.view">
        <field name="name">employee.document.request.form</field>
        <field name="model">employee.document.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Documentos">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,partial,complete,verified"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="expected_delivery_date"/>
                        </group>
                    </group>
                    <field name="document_line_ids">
                        <list editable="bottom">
                            <field name="document_type"/>
                            <field name="attachment_filename" invisible="1"/>
                            <field name="attachment" filename="attachment_filename" string="Archivo"/>
                            <field name="received"/>
                            <field name="received_date" readonly="not received"/>
                            <field name="verified" readonly="not received"/>
                            <field name="verified_date" readonly="not verified"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_employee_document_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de Documentos</field>
        <field name="res_model">employee.document.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_document_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Se crea automáticamente al contratar un candidato</p>
        </field>
    </record>

    <!-- Sin menú propio a propósito: la documentación de cada empleado se
         consulta desde su ficha (hr.employee), vía el botón "Documentos"
         (ver action_view_rrhh_documents en hr_employee.py), no como una
         sección aparte del módulo. -->

</odoo>

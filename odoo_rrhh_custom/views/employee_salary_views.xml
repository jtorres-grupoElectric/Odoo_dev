<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_salary_list" model="ir.ui.view">
        <field name="name">employee.salary.list</field>
        <field name="model">employee.salary</field>
        <field name="arch" type="xml">
            <list string="Salarios Individuales" class="o_rrhh_salary_list" decoration-muted="not is_active">
                <field name="employee_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_active" column_invisible="1"/>
                <field name="base_salary"/>
                <field name="base_salary_lps"/>
                <field name="bonus"/>
                <field name="net_salary_lps"/>
                <field name="net_salary_usd"/>
                <field name="effective_date"/>
            </list>
        </field>
    </record>

    <record id="view_employee_salary_form" model="ir.ui.view">
        <field name="name">employee.salary.form</field>
        <field name="model">employee.salary</field>
        <field name="arch" type="xml">
            <form string="Salario Individual">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="is_active"/>
                            <field name="pays_in_usd"/>
                        </group>
                        <group>
                            <field name="base_salary"/>
                            <field name="base_salary_lps" readonly="1"/>
                            <field name="bonus"/>
                            <field name="net_salary_lps" readonly="1"/>
                            <field name="net_salary_usd" readonly="1"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_salary_search" model="ir.ui.view">
        <field name="name">employee.salary.search</field>
        <field name="model">employee.salary</field>
        <field name="arch" type="xml">
            <search string="Buscar salarios">
                <field name="employee_id"/>
                <filter string="Activos" name="active_only" domain="[('is_active', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Empresa" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_employee_salary" model="ir.actions.act_window">
        <field name="name">Salarios Individuales</field>
        <field name="res_model">employee.salary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_salary_search"/>
        <field name="context">{'search_default_active_only': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Asigna el primer salario individual</p>
        </field>
    </record>

    <menuitem id="menu_employee_salary" name="Salarios"
              parent="menu_rrhh_custom_root" action="action_employee_salary" sequence="40"
              groups="odoo_rrhh_custom.group_rrhh_especialista,odoo_rrhh_custom.group_rrhh_socio,odoo_rrhh_custom.group_rrhh_empleado,odoo_rrhh_custom.group_rrhh_salarios"/>

</odoo>

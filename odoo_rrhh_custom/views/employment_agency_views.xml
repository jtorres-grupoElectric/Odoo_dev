<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employment_agency_list" model="ir.ui.view">
        <field name="name">employment.agency.list</field>
        <field name="model">employment.agency</field>
        <field name="arch" type="xml">
            <list string="Agencias de Empleo">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_employment_agency_form" model="ir.ui.view">
        <field name="name">employment.agency.form</field>
        <field name="model">employment.agency</field>
        <field name="arch" type="xml">
            <form string="Agencia de Empleo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="contact_info"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employment_agency_search" model="ir.ui.view">
        <field name="name">employment.agency.search</field>
        <field name="model">employment.agency</field>
        <field name="arch" type="xml">
            <search string="Buscar agencias de empleo">
                <field name="name"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empresa" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_employment_agency" model="ir.actions.act_window">
        <field name="name">Agencias de Empleo</field>
        <field name="res_model">employment.agency</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employment_agency_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra la primera agencia de empleo</p>
        </field>
    </record>

    <!-- Sin menú propio a propósito: las agencias de empleo se crean al
         vuelo desde el campo "Agencia" de cada candidato, dentro de la
         Solicitud de Contratación (quick-create del Many2one), no como una
         sección aparte del módulo. -->

</odoo>

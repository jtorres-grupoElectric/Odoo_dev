<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_vacation_allocation_list" model="ir.ui.view">
        <field name="name">employee.vacation.allocation.list</field>
        <field name="model">employee.vacation.allocation</field>
        <field name="arch" type="xml">
            <list string="Saldos de Vacaciones">
                <field name="employee_id"/>
                <field name="year"/>
                <field name="years_of_service"/>
                <field name="allocated_days"/>
                <field name="used_days"/>
                <field name="available_days"/>
            </list>
        </field>
    </record>

    <record id="view_employee_vacation_allocation_form" model="ir.ui.view">
        <field name="name">employee.vacation.allocation.form</field>
        <field name="model">employee.vacation.allocation</field>
        <field name="arch" type="xml">
            <form string="Saldo de Vacaciones">
                <header>
                    <button name="action_calculate_legal_days" string="Calcular según ley (Honduras)"
                            type="object" class="oe_highlight"
                            groups="odoo_rrhh_custom.group_rrhh_especialista"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="year"/>
                            <field name="years_of_service" readonly="1"/>
                        </group>
                        <group>
                            <field name="allocated_days"/>
                            <field name="used_days" readonly="1"/>
                            <field name="available_days" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"
                               placeholder="Días asignados según Art. 346 del Código del Trabajo de Honduras: 10 días (1 año), 12 (2 años), 15 (3 años), 20 (4+ años). Ajustable manualmente si la empresa ofrece un beneficio mayor."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_vacation_allocation_search" model="ir.ui.view">
        <field name="name">employee.vacation.allocation.search</field>
        <field name="model">employee.vacation.allocation</field>
        <field name="arch" type="xml">
            <search string="Buscar saldos de vacaciones">
                <field name="employee_id"/>
                <field name="year"/>
                <filter string="Año actual" name="current_year"
                        domain="[('year', '=', context_today().year)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Año" name="group_year" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_employee_vacation_allocation" model="ir.actions.act_window">
        <field name="name">Saldos de Vacaciones</field>
        <field name="res_model">employee.vacation.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_vacation_allocation_search"/>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Asigna el primer saldo de vacaciones</p>
        </field>
    </record>

    <!-- Sin menú propio a propósito: el saldo de vacaciones de cada empleado
         se consulta desde su ficha (botón "Días disp." en hr.employee),
         no como una sección aparte del módulo. -->

</odoo>
